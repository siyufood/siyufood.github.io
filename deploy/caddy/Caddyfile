:9999 {
	# CORS preflight: GitHub Pages -> ngrok -> this gateway
	@preflight method OPTIONS
	handle @preflight {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, PATCH, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type, X-Access-Token, X-Requested-With, Accept, Origin, Authorization, ngrok-skip-browser-warning"
		header Access-Control-Max-Age "86400"
		respond "" 204
	}

	# 内网登录（同源）：/config.js 固定返回相对接口地址，
	# 这样 9999 端口同时提供前端页面和接口，不再依赖公网穿透域名。
	handle /config.js* {
		header Content-Type "application/javascript; charset=utf-8"
		header Cache-Control "no-store"
		respond `window.ERP_CONFIG = { apiBase: '/jshERP-boot' };` 200
	}

	# The Spring Boot app keeps its /jshERP-boot context path.
	handle /jshERP-boot* {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Expose-Headers "Content-Disposition, Content-Type, X-Access-Token"
		reverse_proxy {$BACKEND_ADDR}
	}

	# 内网登录前端（SPA）：直接由网关对外提供 jshERP-web/dist
	handle {
		root * E:/思雨食品ERP/siyu-erp-pages/jshERP-web/dist
		encode gzip
		try_files {path} /index.html
		file_server
	}
}
